{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*.ts", "test/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
