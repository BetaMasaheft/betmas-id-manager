{
	"name": "betmas-id-manager",
	"version": "1.0.0",
	"description": "Standalone id-management service for BetaMasaheft - Node.js/TypeScript implementation",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"dependencies": {
		"fontoxpath": "^3.34.0",
		"slimdom": "^4.3.5"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"ajv": "^8.20.0",
		"ajv-draft-04": "^1.0.0",
		"ajv-formats": "^3.0.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.4.1",
		"prettier": "^3.9.6",
		"typescript": "^5.9.0"
	},
	"scripts": {
		"start": "node src/server.ts",
		"dev": "node --watch src/server.ts",
		"test": "node --test",
		"test:concurrency": "node tests/concurrency-stress.ts",
		"typecheck": "tsc",
		"format:check": "prettier --check .",
		"format:write": "prettier --write .",
		"validate:openapi": "node scripts/validate-openapi.ts",
		"prepare": "husky || true"
	},
	"lint-staged": {
		"*": "prettier --write --ignore-unknown",
		"api.json": "node scripts/validate-openapi.ts"
	}
}
